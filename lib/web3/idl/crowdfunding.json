  "metadata": {
    "name": "crowdfunding",
    "version": "0.1.0",
    "spec": "0.1.0",
    "description": "Amanat Protocol — Civic Crowdfunding with State Matching"
  },
  "instructions": [
    {
      "name": "init_campaign",
      "docs": [
        "Create a crowdfunding campaign. Citizen target and state match are auto-calculated from category.",
        "Only citizens with tier >= ACTIVE can create campaigns."
      ],
      "discriminator": [45, 178, 33, 112, 200, 15, 88, 142],
      "accounts": [
        {
          "name": "campaign",
          "writable": true,
          "pda": {
            "seeds": [
              {"kind": "const", "value": [99, 97, 109, 112, 97, 105, 103, 110]},
              {"kind": "account", "path": "creator"},
              {"kind": "arg", "path": "title"}
            ]
          }
        },
        {
          "name": "escrow",
          "writable": true,
          "pda": {
            "seeds": [
              {"kind": "const", "value": [99, 102, 95, 101, 115, 99, 114, 111, 119]},
              {"kind": "account", "path": "campaign"}
            ]
          }
        },
        {
          "name": "creator",
          "writable": true,
          "signer": true
        },
        {
          "name": "system_program",
          "address": "11111111111111111111111111111111"
        }
      ],
      "args": [
        {"name": "title", "type": "string"},
        {"name": "description", "type": "string"},
        {"name": "district", "type": "string"},
        {"name": "category", "type": {"defined": {"name": "CampaignCategory"}}},
        {"name": "target_amount", "type": "u64"},
        {"name": "deadline", "type": "i64"},
        {"name": "lat", "type": "f64"},
        {"name": "lng", "type": "f64"}
      ]
    },
    {
      "name": "contribute",
      "docs": [
        "Contribute funds to a campaign. Min 500 tenge, max 500000 tenge.",
        "Funds are held in escrow until campaign succeeds or expires."
      ],
      "discriminator": [82, 119, 205, 18, 147, 33, 64, 200],
      "accounts": [
        {
          "name": "campaign",
          "writable": true
        },
        {
          "name": "escrow",
          "writable": true,
          "pda": {
            "seeds": [
              {"kind": "const", "value": [99, 102, 95, 101, 115, 99, 114, 111, 119]},
              {"kind": "account", "path": "campaign"}
            ]
          }
        },
        {
          "name": "donor_record",
          "writable": true,
          "pda": {
            "seeds": [
              {"kind": "const", "value": [100, 111, 110, 111, 114]},
              {"kind": "account", "path": "campaign"},
              {"kind": "account", "path": "donor"}
            ]
          }
        },
        {
          "name": "donor",
          "writable": true,
          "signer": true
        },
        {
          "name": "system_program",
          "address": "11111111111111111111111111111111"
        }
      ],
      "args": [
        {"name": "amount", "type": "u64"},
        {"name": "anonymous", "type": "bool"}
      ]
    },
    {
      "name": "match_funds",
      "docs": [
        "Akimat deposits state matching funds after citizen target is reached.",
        "Campaign status transitions from FUNDED to MATCHED."
      ],
      "discriminator": [156, 44, 201, 88, 15, 112, 67, 29],
      "accounts": [
        {
          "name": "campaign",
          "writable": true
        },
        {
          "name": "escrow",
          "writable": true,
          "pda": {
            "seeds": [
              {"kind": "const", "value": [99, 102, 95, 101, 115, 99, 114, 111, 119]},
              {"kind": "account", "path": "campaign"}
            ]
          }
        },
        {
          "name": "akimat",
          "writable": true,
          "signer": true
        },
        {
          "name": "system_program",
          "address": "11111111111111111111111111111111"
        }
      ],
      "args": []
    },
    {
      "name": "refund_all",
      "docs": [
        "Refund all contributions if campaign expired without reaching target.",
        "Can be called by anyone after deadline passes. 100% refund, 0% fees."
      ],
      "discriminator": [210, 87, 45, 178, 22, 90, 134, 55],
      "accounts": [
        {
          "name": "campaign",
          "writable": true
        },
        {
          "name": "escrow",
          "writable": true,
          "pda": {
            "seeds": [
              {"kind": "const", "value": [99, 102, 95, 101, 115, 99, 114, 111, 119]},
              {"kind": "account", "path": "campaign"}
            ]
          }
        },
        {
          "name": "caller",
          "signer": true
        }
      ],
      "args": []
    },
    {
      "name": "finalize_campaign",
      "docs": [
        "Link the campaign to a government contract after matching is complete.",
        "Funds are transferred to the contract escrow. Status → IN_PROGRESS."
      ],
      "discriminator": [88, 177, 45, 201, 55, 90, 134, 22],
      "accounts": [
        {
          "name": "campaign",
          "writable": true
        },
        {
          "name": "escrow",
          "writable": true,
          "pda": {
            "seeds": [
              {"kind": "const", "value": [99, 102, 95, 101, 115, 99, 114, 111, 119]},
              {"kind": "account", "path": "campaign"}
            ]
          }
        },
        {
          "name": "contract",
          "writable": true
        },
        {
          "name": "authority",
          "writable": true,
          "signer": true
        },
        {
          "name": "system_program",
          "address": "11111111111111111111111111111111"
        }
      ],
      "args": [
        {"name": "contract_pubkey", "type": "pubkey"}
      ]
    }
  ],
  "accounts": [
