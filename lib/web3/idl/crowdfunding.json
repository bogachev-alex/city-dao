      "discriminator": [174, 87, 222, 126, 23, 59, 189, 155],
      "accounts": [
        {
          "name": "campaign",
          "writable": true
        },
        {
          "name": "escrow",
          "writable": true,
          "pda": {
            "seeds": [
              {"kind": "const", "value": [99, 102, 95, 101, 115, 99, 114, 111, 119]},
