  "instructions": [
    {
      "name": "init_campaign",
      "docs": [
        "Create a crowdfunding campaign. Citizen target and state match are auto-calculated from category.",
        "Only citizens with tier >= ACTIVE can create campaigns."
      ],
      "discriminator": [154, 188, 249, 244, 226, 210, 253, 109],
      "accounts": [
        {
          "name": "campaign",
          "writable": true,
          "pda": {
            "seeds": [
              {"kind": "const", "value": [99, 97, 109, 112, 97, 105, 103, 110]},
              {"kind": "account", "path": "creator"},
              {"kind": "arg", "path": "title"}
            ]
          }
        },
        {
          "name": "escrow",
          "writable": true,
          "pda": {
            "seeds": [
              {"kind": "const", "value": [99, 102, 95, 101, 115, 99, 114, 111, 119]},
              {"kind": "account", "path": "campaign"}
            ]
          }
        },
        {
          "name": "creator",
          "writable": true,
          "signer": true
        },
        {
          "name": "system_program",
          "address": "11111111111111111111111111111111"
        }
      ],
      "args": [
        {"name": "title", "type": "string"},
        {"name": "description", "type": "string"},
        {"name": "district", "type": "string"},
        {"name": "category", "type": {"defined": {"name": "CampaignCategory"}}},
        {"name": "target_amount", "type": "u64"},
        {"name": "deadline", "type": "i64"},
        {"name": "lat", "type": "f64"},
        {"name": "lng", "type": "f64"}
      ]
    },
    {
      "name": "contribute",
      "docs": [
        "Contribute funds to a campaign. Min 500 tenge, max 500000 tenge.",
        "Funds are held in escrow until campaign succeeds or expires."
      ],
      "discriminator": [82, 33, 68, 131, 32, 0, 205, 95],
      "accounts": [
        {
          "name": "campaign",
          "writable": true
        },
        {
          "name": "escrow",
          "writable": true,
          "pda": {
            "seeds": [
              {"kind": "const", "value": [99, 102, 95, 101, 115, 99, 114, 111, 119]},
              {"kind": "account", "path": "campaign"}
            ]
          }
        },
        {
          "name": "donor_record",
          "writable": true,
          "pda": {
            "seeds": [
              {"kind": "const", "value": [100, 111, 110, 111, 114]},
              {"kind": "account", "path": "campaign"},
              {"kind": "account", "path": "donor"}
            ]
          }
        },
        {
          "name": "donor",
          "writable": true,
          "signer": true
        },
        {
          "name": "system_program",
          "address": "11111111111111111111111111111111"
        }
      ],
      "args": [
        {"name": "amount", "type": "u64"},
        {"name": "anonymous", "type": "bool"}
      ]
    },
    {
      "name": "match_funds",
      "docs": [
        "Akimat deposits state matching funds after citizen target is reached.",
        "Campaign status transitions from FUNDED to MATCHED."
