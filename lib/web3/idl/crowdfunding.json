      "discriminator": [27, 210, 246, 35, 195, 126, 75, 207],
      "accounts": [
        {
          "name": "campaign",
          "writable": true
        },
        {
          "name": "escrow",
          "writable": true,
          "pda": {
            "seeds": [
              {"kind": "const", "value": [99, 102, 95, 101, 115, 99, 114, 111, 119]},
              {"kind": "account", "path": "campaign"}
            ]
          }
        },
        {
          "name": "akimat",
          "writable": true,
          "signer": true
        },
        {
          "name": "system_program",
          "address": "11111111111111111111111111111111"
        }
      ],
      "args": []
    },
    {
      "name": "refund_all",
      "docs": [
