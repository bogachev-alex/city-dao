      "discriminator": [241, 76, 201, 221, 33, 222, 220, 138],
      "accounts": [
        {
          "name": "campaign",
          "writable": true
        },
        {
          "name": "escrow",
          "writable": true,
          "pda": {
            "seeds": [
              {"kind": "const", "value": [99, 102, 95, 101, 115, 99, 114, 111, 119]},
              {"kind": "account", "path": "campaign"}
