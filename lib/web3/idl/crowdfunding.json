          }
        },
        {
          "name": "contract",
          "writable": true
        },
        {
          "name": "authority",
          "writable": true,
          "signer": true
        },
        {
          "name": "system_program",
          "address": "11111111111111111111111111111111"
        }
      ],
      "args": [
        {"name": "contract_pubkey", "type": "pubkey"}
      ]
    }
