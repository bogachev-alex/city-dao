# Data source: "mock" (demo data, no wallet needed) | "onchain" (Solana devnet)
NEXT_PUBLIC_DATA_SOURCE=mock

# Solana network is forced to devnet in code.
# NEXT_PUBLIC_SOLANA_RPC_URL is intentionally ignored to prevent mainnet usage.

# OpenAI (for AI Research Agent)
OPENAI_API_KEY=

# Pinata IPFS (for milestone evidence uploads)
PINATA_JWT=
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud
